<UserControl x:Class="image2gdram_converter.Controls.CodeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource Button.Copy}" Command="{Binding CopyCommand}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <Button Content="{DynamicResource Button.SaveOutput}" Command="{Binding SaveOutputCommand}" VerticalAlignment="Center"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding CodeFiles}"
                     SelectedIndex="{Binding CodeIndex, Mode=TwoWay}"
                     BorderThickness="0"
                     Background="Transparent"
                     Visibility="{Binding ShowCodeFiles, Converter={StaticResource BoolToVis}}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Caption}" Margin="8,2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <Border x:Name="EditorHost" BorderBrush="#FFB0B0B0" BorderThickness="1"/>
    </DockPanel>
</UserControl>

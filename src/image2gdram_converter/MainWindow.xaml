<Window x:Class="image2gdram_converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:image2gdram_converter.Views"
        Title="{Binding WindowTitle}"
        MinWidth="1024" MinHeight="680"
        Width="1200" Height="800"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoActiveCommand}"/>
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoActiveCommand}"/>
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem Header="{DynamicResource Menu.OpenImage}" Command="{Binding Image.OpenImageCommand}"/>
                <MenuItem Header="{DynamicResource Menu.OpenSheet}" Command="{Binding Font.OpenSheetCommand}"/>
                <MenuItem Header="{DynamicResource Menu.OpenImport}" Command="{Binding Font.OpenImportCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu.NewProject}" Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="{DynamicResource Menu.OpenProject}" Command="{Binding OpenProjectCommand}"/>
                <MenuItem Header="{DynamicResource Menu.SaveProject}" Command="{Binding SaveProjectCommand}"/>
                <MenuItem Header="{DynamicResource Menu.SaveProjectAs}" Command="{Binding SaveProjectAsCommand}"/>
                <MenuItem Header="{DynamicResource Menu.Recent}" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}"/>
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu.SaveOutput}" Command="{Binding SaveActiveCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu.Exit}" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Edit}">
                <MenuItem Header="{DynamicResource Menu.Undo}" Command="{Binding UndoActiveCommand}" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="{DynamicResource Menu.Redo}" Command="{Binding RedoActiveCommand}" InputGestureText="Ctrl+Y"/>
                <Separator/>
                <MenuItem Header="{DynamicResource Menu.Copy}" Command="{Binding CopyActiveCommand}"/>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </StatusBar>
        <TabControl SelectedIndex="{Binding SelectedTab}">
            <TabItem Header="{DynamicResource Tab.Image}">
                <views:ImageConverterView DataContext="{Binding Image}"/>
            </TabItem>
            <TabItem Header="{DynamicResource Tab.Font}">
                <views:FontGeneratorView DataContext="{Binding Font}"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>

<UserControl x:Class="image2gdram_converter.Views.ImageConverterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:image2gdram_converter.Controls">
    <UserControl.Resources>
        <controls:RgbaImageConverter x:Key="RgbaToBitmap"/>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8">
                <TextBlock Style="{StaticResource Section}" Margin="0,0,0,4" Text="{DynamicResource Section.Source}"/>
                <Button Content="{DynamicResource Button.OpenImage}" Command="{Binding OpenImageCommand}" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding SourceName}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Frame}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}"
                              Visibility="{Binding IsAnimated, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <CheckBox Content="{DynamicResource Check.AllFrames}" IsChecked="{Binding ExportAllFrames}"
                          Visibility="{Binding IsAnimated, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Background}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Backgrounds}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Background}"/>
                </Grid>

                <TextBlock Style="{StaticResource Section}" Text="{DynamicResource Section.Transform}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Rotation}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Rotations}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Rotation}"/>
                </Grid>
                <CheckBox Content="{DynamicResource Check.FlipHorizontal}" IsChecked="{Binding FlipHorizontal}" Margin="0,4,0,0"/>
                <CheckBox Content="{DynamicResource Check.FlipVertical}" IsChecked="{Binding FlipVertical}" Margin="0,4,0,0"/>

                <TextBlock Style="{StaticResource Section}" Text="{DynamicResource Section.Size}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Preset}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Presets.Items}" DisplayMemberPath="Caption"
                              SelectedItem="{Binding Presets.Selected}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                    <Button Content="{DynamicResource Button.SavePreset}" Command="{Binding SavePresetCommand}" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Button.RenamePreset}" Command="{Binding RenamePresetCommand}" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Button.DeletePreset}" Command="{Binding DeletePresetCommand}"/>
                </StackPanel>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.SizeMode}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SizeModes}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding SizeMode}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Width}"/>
                    <TextBox Grid.Column="1" IsEnabled="{Binding ManualSize}">
                        <TextBox.Text>
                            <Binding Path="WidthText" UpdateSourceTrigger="PropertyChanged" Delay="400"/>
                        </TextBox.Text>
                    </TextBox>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Height}"/>
                    <TextBox Grid.Column="1" IsEnabled="{Binding ManualSize}">
                        <TextBox.Text>
                            <Binding Path="HeightText" UpdateSourceTrigger="PropertyChanged" Delay="400"/>
                        </TextBox.Text>
                    </TextBox>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Fit}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Fits}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Fit}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Alignment}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Alignments}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Alignment}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.OffsetX}"/>
                    <TextBox Grid.Column="1">
                        <TextBox.Text>
                            <Binding Path="OffsetXText" UpdateSourceTrigger="PropertyChanged" Delay="400"/>
                        </TextBox.Text>
                    </TextBox>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.OffsetY}"/>
                    <TextBox Grid.Column="1">
                        <TextBox.Text>
                            <Binding Path="OffsetYText" UpdateSourceTrigger="PropertyChanged" Delay="400"/>
                        </TextBox.Text>
                    </TextBox>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Resample}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Resamples}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Resample}"/>
                </Grid>

                <TextBlock Style="{StaticResource Section}" Text="{DynamicResource Section.Binarize}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Binarize}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding BinarizeModes}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Binarize}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Threshold}"/>
                    <DockPanel Grid.Column="1">
                        <TextBox Width="64" DockPanel.Dock="Right" Margin="6,0,0,0">
                            <TextBox.Text>
                                <Binding Path="ThresholdText" UpdateSourceTrigger="PropertyChanged" Delay="400"/>
                            </TextBox.Text>
                        </TextBox>
                        <Slider Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Threshold, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </Grid>

                <TextBlock Style="{StaticResource Section}" Text="{DynamicResource Section.Packing}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Direction}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Directions}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Direction}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.BitOrder}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding BitOrders}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding BitOrder}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Bits}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding BitCounts}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding BitsPerByte}"
                              IsEnabled="{Binding BitsEnabled}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Traversal}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Traversals}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Traversal}"
                              IsEnabled="{Binding TraversalEnabled}"/>
                </Grid>
                <CheckBox Content="{DynamicResource Check.Invert}" IsChecked="{Binding Invert}" Margin="0,4,0,0"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Scheme}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Schemes}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Scheme}"/>
                </Grid>

                <TextBlock Style="{StaticResource Section}" Text="{DynamicResource Section.Output}"/>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Format}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Formats}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Format}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.ArrayName}"/>
                    <TextBox Grid.Column="1">
                        <TextBox.Text>
                            <Binding Path="ArrayName" UpdateSourceTrigger="PropertyChanged" Delay="400"/>
                        </TextBox.Text>
                    </TextBox>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Encoding}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Encodings}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Encoding}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.BytesPerLine}"/>
                    <TextBox Grid.Column="1">
                        <TextBox.Text>
                            <Binding Path="BytesPerLineText" UpdateSourceTrigger="PropertyChanged" Delay="400"/>
                        </TextBox.Text>
                    </TextBox>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.AsmNumber}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AsmNumberFormats}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding AsmNumbers}"
                              IsEnabled="{Binding AsmEnabled}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.AsmExtension}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding AsmExtensions}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding AsmExtension}"
                              IsEnabled="{Binding AsmEnabled}"/>
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Field}" Text="{DynamicResource Label.Stm32Type}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Stm32Types}" DisplayMemberPath="Caption"
                              SelectedValuePath="Value" SelectedValue="{Binding Stm32Type}"
                              IsEnabled="{Binding Stm32Enabled}"/>
                </Grid>
                <CheckBox Content="{DynamicResource Check.IncludeDate}" IsChecked="{Binding IncludeDate}" Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Button.Copy}" Command="{Binding CopyCommand}" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Button.SaveOutput}" Command="{Binding SaveOutputCommand}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" Margin="8,8,8,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="140"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Text="{DynamicResource Label.Zoom}"/>
                <ComboBox DockPanel.Dock="Left" Width="160" ItemsSource="{Binding Zooms}" DisplayMemberPath="Caption"
                          SelectedItem="{Binding Zoom}" Margin="0,0,12,0"/>
                <CheckBox Content="{DynamicResource Check.Grid}" IsChecked="{Binding ShowGrid}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="{DynamicResource Button.Undo}" Command="{Binding UndoCommand}" Margin="0,0,6,0" DockPanel.Dock="Right"/>
                <Button Content="{DynamicResource Button.Redo}" Command="{Binding RedoCommand}" DockPanel.Dock="Right" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding ResultSizeText}" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Label.Source}" Margin="0,0,0,4"/>
                    <Border BorderBrush="#FFB0B0B0" BorderThickness="1" Background="#FFE8E8E8">
                        <Image Source="{Binding SourcePreview, Converter={StaticResource RgbaToBitmap}}" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </DockPanel>
                <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Label.Result}" Margin="0,0,0,4"/>
                    <controls:PixelGridControl x:Name="Pixels"
                                               Pixels="{Binding Preview}"
                                               Invert="{Binding Invert}"
                                               Scheme="{Binding Scheme}"
                                               Scale="{Binding Scale}"
                                               FitToWindow="{Binding FitToWindow}"
                                               ShowGrid="{Binding ShowGrid}"
                                               Direction="{Binding Direction}"
                                               BitsPerByte="{Binding BitsPerByte}"/>
                </DockPanel>
            </Grid>
            <TextBlock Grid.Row="2" Margin="0,4,0,4" Text="{Binding HoverText}" TextWrapping="Wrap" MinHeight="18"/>
            <DockPanel Grid.Row="3">
                <TextBlock DockPanel.Dock="Top" Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="#FF8A4B00" Margin="0,0,0,4"/>
                <controls:CodeView/>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
